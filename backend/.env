# =============================================================================
# MakeMyCV Backend — Non-Sensitive Environment Defaults
# =============================================================================
# This file is safe to commit. It contains ONLY non-sensitive defaults.
#
# For LOCAL development: put your real secrets in backend/.env.local
# (that file is gitignored and will never be committed)
#
# For CI/CD: secrets are injected from GitHub Secrets by the workflow.
# =============================================================================

# --- SMTP / Email (non-sensitive) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAILS_FROM_NAME=MakeMyCV
