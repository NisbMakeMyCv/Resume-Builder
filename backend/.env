# =============================================================================
# MakeMyCV Backend — Non-Sensitive Environment Defaults
# =============================================================================
# This file is safe to commit. It contains ONLY non-sensitive configuration.
# Sensitive values (secrets) are injected at runtime by GitHub Actions
# from GitHub Secrets, so the final .env used by Docker is never stored here.
# =============================================================================

# --- SMTP / Email Settings (non-sensitive) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAILS_FROM_NAME=MakeMyCV


# --- Sensitive values below are placeholders ---
# These will be overwritten at runtime by the CI/CD pipeline.
# For LOCAL development, fill these in manually (never commit real values).
JWT_SECRET_KEY=replace_me_locally
SMTP_USER=replace_me_locally
SMTP_PASSWORD=replace_me_locally
EMAILS_FROM_EMAIL=replace_me_locally
